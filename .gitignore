infrastructure/.env

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/
*.so

# ---- Node / Next.js ----
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Database ----
*.db
*.sqlite3
foodloop.db

# ---- Uploads & Generated ----
uploads/
backend/uploads/
backend/vector_store/
vector_store/

# ---- Testing ----
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
