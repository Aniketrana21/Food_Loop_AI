# ====================================================================
# FOODLOOP AI - Enterprise Production Environment Configuration
# Copy this file to .env and configure values for your environment.
# NEVER commit production passwords, keys, or real secrets to version control.
# ====================================================================

# --------------------------------------------------------------------
# 1. Project & Core Security
# --------------------------------------------------------------------
PROJECT_NAME="FoodLoop AI"
API_V1_STR="/api/v1"
ENVIRONMENT="production" # development | staging | production
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-cryptographically-secure-random-string-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# --------------------------------------------------------------------
# 2. Database Connection (Supabase PostgreSQL / PostGIS)
# --------------------------------------------------------------------
# Production Supabase Connection Pooler (Session/Transaction mode):
DATABASE_URL="postgresql://postgres.your-project-ref:your_strong_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Local SQLite Fallback (used when remote Postgres is unreachable during offline development)
FALLBACK_SQLITE_URL="sqlite:///./foodloop.db"

# --------------------------------------------------------------------
# 3. Supabase Auth & Storage Configuration
# --------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-admin-key"

# Storage Bucket Names
SUPABASE_STORAGE_BUCKET_DOCUMENTS="foodloop-documents"
SUPABASE_STORAGE_BUCKET_AVATARS="foodloop-avatars"
SUPABASE_STORAGE_BUCKET_IMAGES="foodloop-images"

# --------------------------------------------------------------------
# 4. LLM Providers (Provider-Agnostic Engine)
# --------------------------------------------------------------------
LLM_PROVIDER="gemini" # gemini | openai | anthropic | mock
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# --------------------------------------------------------------------
# 5. Geolocation & Dispatch Optimization
# --------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN="pk.your_mapbox_token"
DEFAULT_LATITUDE=37.7749
DEFAULT_LONGITUDE=-122.4194

# --------------------------------------------------------------------
# 6. CORS & Hostnames
# --------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://foodloop-ai.vercel.app","https://yourdomain.com"]

# --------------------------------------------------------------------
# 7. Frontend Public Environment Variables (Next.js / Vercel)
# --------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api.yourdomain.com/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token"

# --------------------------------------------------------------------
# 8. Observability, Logging & Monitoring
# --------------------------------------------------------------------
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
PROMETHEUS_METRICS_ENABLED="true"
SENTRY_DSN=""
