# FoodLoop AI - Infrastructure & Deployment Environment Variables Template
# Copy this template to .env or inject these variables into your Cloud platform (Vercel / Render / ECS).
# NEVER commit real passwords or production secrets to version control.

# -----------------------------------------------------------------------------
# Frontend Configuration (Next.js / Vercel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# -----------------------------------------------------------------------------
# Backend Configuration (FastAPI / Cloud Run / Container)
# -----------------------------------------------------------------------------
PROJECT_NAME="FoodLoop AI"
ENVIRONMENT=production
API_V1_STR="/api/v1"
SECRET_KEY="generate-secure-production-jwt-key-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supabase PostgreSQL Connection Pooler)
# Use transaction/session pooler port 5432 or 6543 with sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
FALLBACK_SQLITE_URL=sqlite:///./foodloop.db

# Supabase Admin / Service Role
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-admin-key

# Storage Buckets
SUPABASE_STORAGE_BUCKET_DOCUMENTS=foodloop-documents
SUPABASE_STORAGE_BUCKET_AVATARS=foodloop-avatars
SUPABASE_STORAGE_BUCKET_IMAGES=foodloop-images

# LLM Providers (Gemini / OpenAI / Anthropic / Mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Geolocation & Dispatch Optimization
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_secret_or_public_token

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["https://foodloop-ai.vercel.app","https://yourdomain.com"]

# Observability & Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
